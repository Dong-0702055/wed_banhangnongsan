# Change every credential before using this outside local development.
MYSQL_DATABASE=lifegift
MYSQL_USER=lifegift_app
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
JWT_SECRET=replace-this-with-at-least-32-random-characters

# Host ports (change if these ports are already occupied).
FRONTEND_PORT=8080
BACKEND_PORT=8081
MYSQL_PORT=3307
